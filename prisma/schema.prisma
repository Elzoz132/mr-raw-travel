// Prisma Schema for Mr.Raw Travel - Enterprise Tourism Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid())
  name               String?
  email              String    @unique
  password           String?
  role               String    @default("CUSTOMER") // SUPER_ADMIN, ADMIN, CONTENT_EDITOR, CUSTOMER_SUPPORT, CUSTOMER
  status             String    @default("ACTIVE")   // ACTIVE, SUSPENDED, UNVERIFIED
  phone              String?
  whatsApp           String?
  nationality        String?
  country            String?
  city               String?
  avatar             String?
  language           String    @default("en")
  lastLoginAt        DateTime?
  isTwoFactorEnabled Boolean   @default(false)
  twoFactorSecret    String?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt
  deletedAt          DateTime?

  bookings           Booking[]
  reviews            Review[]
  activityLogs       ActivityLog[]
  auditLogs          AuditLog[]
  loginHistories     LoginHistory[]
  sessions           UserSession[]
  customerProfile    CustomerProfile?

  @@index([email])
  @@index([role])
  @@index([status])
}

model CustomerProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalSpendUsd    Float    @default(0)
  totalSpendEur    Float    @default(0)
  totalSpendEgp    Float    @default(0)
  totalSpendGbp    Float    @default(0)
  bookingCount     Int      @default(0)
  segment          String   @default("STANDARD") // VIP, GOLD, REPEAT, STANDARD, FAMILY
  favoriteCategory String?
  marketingSource  String?  @default("DIRECT")
  tags             String?  // JSON string e.g. ["German", "Yacht", "High Value"]
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([segment])
}

model TripCategory {
  id          String   @id @default(uuid())
  slug        String   @unique
  nameEn      String
  nameAr      String
  nameDe      String
  descEn      String?
  descAr      String?
  descDe      String?
  icon        String?
  image       String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trips       Trip[]

  @@index([slug])
}

model Trip {
  id              String         @id @default(uuid())
  slug            String         @unique
  titleEn         String
  titleAr         String
  titleDe         String
  descEn          String
  descAr          String
  descDe          String
  categoryId      String
  category        TripCategory   @relation(fields: [categoryId], references: [id])
  
  // Base Prices Across 4 Currencies
  priceAdultUsd   Float
  priceChildUsd   Float
  priceAdultEur   Float
  priceChildEur   Float
  priceAdultEgp   Float
  priceChildEgp   Float
  priceAdultGbp   Float          @default(38.0)
  priceChildGbp   Float          @default(20.0)

  duration        String         // e.g. "8 Hours"
  pickupTime      String         // e.g. "08:00 AM"
  location        String         @default("Hurghada, Egypt")
  meetingPoint    String?
  maxSeats        Int            @default(30)
  bookedSeats     Int            @default(0)
  isFeatured      Boolean        @default(false)
  isSpecialOffer  Boolean        @default(false)
  discountPercent Int            @default(0)
  rating          Float          @default(4.9)
  reviewCount     Int            @default(0)

  includedEn      String
  includedAr      String
  includedDe      String
  excludedEn      String
  excludedAr      String
  excludedDe      String
  itineraryEn     String
  itineraryAr     String
  itineraryDe     String

  coverImage      String
  isPublished     Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  images          TripImage[]
  packages        TripPackage[]
  bookings        Booking[]
  reviews         Review[]
  schedules       TripSchedule[]
  pricingRules    TripPricingRule[]

  @@index([slug])
  @@index([categoryId])
  @@index([isPublished])
  @@index([isFeatured])
}

model TripPackage {
  id              String   @id @default(uuid())
  tripId          String
  trip            Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  
  nameEn          String
  nameAr          String
  nameDe          String
  descEn          String?
  descAr          String?
  descDe          String?

  priceAdultUsd   Float
  priceChildUsd   Float
  priceAdultEur   Float
  priceChildEur   Float
  priceAdultEgp   Float
  priceChildEgp   Float
  priceAdultGbp   Float    @default(38.0)
  priceChildGbp   Float    @default(20.0)

  oldPriceAdultUsd Float?
  oldPriceAdultEur Float?
  oldPriceAdultEgp Float?
  oldPriceAdultGbp Float?

  discountPercent Int      @default(0)
  currency        String   @default("USD")

  includedEn      String?  // JSON string array
  includedAr      String?  // JSON string array
  includedDe      String?  // JSON string array
  excludedEn      String?  // JSON string array
  excludedAr      String?  // JSON string array
  excludedDe      String?  // JSON string array

  duration        String?  // e.g. "Full Day (8 Hours)"
  startTime       String?  @default("08:00 AM")
  endTime         String?  @default("04:00 PM")
  minGuests       Int      @default(1)
  maxGuests       Int      @default(30)

  cancellationPolicyEn String?
  cancellationPolicyAr String?
  cancellationPolicyDe String?
  meetingPointEn  String?
  meetingPointAr  String?
  meetingPointDe  String?
  googleMapsUrl   String?

  packageColor    String?  @default("#D4AF37")
  packageIcon     String?  @default("Crown")

  itinerarySteps  String?  // JSON string array of itinerary timeline objects

  availableDays   String?  // JSON string array e.g. ["MON", "WED", "FRI"]
  capacity        Int      @default(20)

  photos          String?  // JSON string array of URLs
  video           String?  // Video URL or JSON
  badge           String?  // e.g. "BEST VALUE", "VIP CHARTER"
  isPopular       Boolean  @default(false)
  isRecommended   Boolean  @default(false)
  isBestSeller    Boolean  @default(false)
  
  order           Int      @default(0)
  status          String   @default("ACTIVE") // ACTIVE, HIDDEN, ARCHIVED

  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  bookings        Booking[]
  reviews         Review[]

  @@index([tripId])
  @@index([status])
}

model TripAddon {
  id           String   @id @default(uuid())
  nameEn       String
  nameAr       String
  nameDe       String
  descEn       String?
  descAr       String?
  descDe       String?
  category     String   @default("GENERAL") // SAFARI, WATER_SPORTS, YACHT, HORSE, GENERAL
  priceEgp     Float
  priceUsd     Float    @default(0)
  priceEur     Float    @default(0)
  icon         String?  @default("Sparkles")
  isCustomable Boolean  @default(true)
  isAddon      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PaymentGateway {
  id             String   @id @default(uuid())
  key            String   @unique // STRIPE, PAYMOB, PAYPAL, VODAFONE_CASH, INSTAPAY, CASH
  name           String
  isEnabled      Boolean  @default(true)
  instructionsEn String?
  instructionsAr String?
  instructionsDe String?
  updatedAt      DateTime @default(now()) @updatedAt
}

model TripPricingRule {
  id              String   @id @default(uuid())
  tripId          String
  trip            Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  ruleName        String   // e.g. "SUMMER_DISCOUNT", "PEAK_HOLIDAY", "EARLY_BIRD"
  seasonType      String   @default("STANDARD") // SUMMER, WINTER, HOLIDAY, WEEKEND, VIP
  multiplier      Float    @default(1.0) // e.g. 1.25 for +25% peak
  startDate       DateTime?
  endDate         DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model TripImage {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  mediaType String   @default("IMAGE") // IMAGE, VIDEO, PANORAMA_360, THUMBNAIL, COVER
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model TripSchedule {
  id             String   @id @default(uuid())
  tripId         String
  trip           Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  date           DateTime
  pickupTime     String?
  maxSeats       Int      @default(30)
  availableSeats Int      @default(30)
  reservedSeats  Int      @default(0)
  bookedSeats    Int      @default(0)
  waitingListCount Int    @default(0)
  status         String   @default("OPEN") // OPEN, FULL, CANCELLED, COMPLETED
  guideId        String?
  driverId       String?
  vehicleId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bookings       Booking[]

  @@index([tripId, date])
  @@index([status])
}

model Booking {
  id              String        @id @default(uuid())
  bookingNumber   String        @unique
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
  tripId          String
  trip            Trip          @relation(fields: [tripId], references: [id])
  packageId       String?
  package         TripPackage?  @relation(fields: [packageId], references: [id])
  scheduleId      String?
  schedule        TripSchedule? @relation(fields: [scheduleId], references: [id])
  
  tripDate        DateTime
  pickupLocation  String
  hotelName       String
  hotelAddress    String?
  roomNumber      String?
  pickupTime      String?

  leadPassengerName String
  leadEmail         String
  leadPhone         String
  leadWhatsApp      String
  leadNationality   String
  emergencyContact  String?
  specialNotes      String?

  adults          Int           @default(1)
  children        Int           @default(0)
  currency        String        @default("USD") // USD, EUR, EGP, GBP
  totalPrice      Float
  selectedAddons  String?       // JSON string array of selected addon objects {id, nameAr, priceEgp, etc}
  isCustomPackage Boolean       @default(false)
  
  paymentMethod   String        // CASH, INSTAPAY, VODAFONE_CASH, BANK_TRANSFER, CARD
  paymentStatus   String        @default("PENDING") // PENDING, WAITING_REVIEW, APPROVED, REJECTED, REFUNDED
  bookingStatus   String        @default("PENDING") // PENDING, CONFIRMED, CANCELLED, COMPLETED

  qrToken         String        @unique
  voucherPdfUrl   String?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  passengers      BookingPassenger[]
  payments        Payment[]
  receipts        PaymentReceipt[]
  reviews         Review[]

  @@index([bookingNumber])
  @@index([userId])
  @@index([paymentStatus])
  @@index([bookingStatus])
  @@index([tripDate])
}

model BookingPassenger {
  id        String   @id @default(uuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  name      String
  type      String   @default("ADULT") // ADULT, CHILD
  passport  String?
  createdAt DateTime @default(now())
}

model Payment {
  id            String          @id @default(uuid())
  bookingId     String
  booking       Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount        Float
  currency      String          @default("USD")
  method        String          // CASH, INSTAPAY, VODAFONE_CASH, BANK_TRANSFER, CARD
  status        String          @default("PENDING") // PENDING, SUCCESS, FAILED
  transactionId String?
  notes         String?
  createdAt     DateTime        @default(now())

  receipts      PaymentReceipt[]
}

model PaymentReceipt {
  id         String   @id @default(uuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paymentId  String?
  payment    Payment? @relation(fields: [paymentId], references: [id])
  imageUrl   String
  fileType   String   @default("IMAGE")
  status     String   @default("PENDING") // PENDING, APPROVED, REJECTED
  adminNotes String?
  uploadedAt DateTime @default(now())

  @@index([status])
}

model Review {
  id          String       @id @default(uuid())
  tripId      String
  trip        Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  packageId   String?
  package     TripPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  bookingId   String?
  booking     Booking?     @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?        @relation(fields: [userId], references: [id])
  
  author      String
  country     String       @default("Germany")
  rating      Int          @default(5)
  title       String?
  comment     String
  avatar      String?
  photos      String?      // JSON string array of review photos
  
  travelDate  DateTime?
  isVerified  Boolean      @default(true)
  status      String       @default("PENDING") // APPROVED, PENDING, REJECTED, HIDDEN
  isPinned    Boolean      @default(false)
  isFeatured  Boolean      @default(false)
  adminReply  String?
  isAnonymous Boolean      @default(false)
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt

  @@index([tripId])
  @@index([status])
}

model GalleryItem {
  id          String   @id @default(uuid())
  titleEn     String
  titleAr     String
  titleDe     String
  category    String   @default("SEA")
  url         String
  location    String   @default("Hurghada")
  mediaType   String   @default("IMAGE") // IMAGE, VIDEO, 360, DRONE
  order       Int      @default(0)
  isFeatured  Boolean  @default(false)
  altTextEn   String?
  altTextAr   String?
  altTextDe   String?
  createdAt   DateTime @default(now())

  @@index([category])
  @@index([isFeatured])
}

model BlogPost {
  id          String   @id @default(uuid())
  slug        String   @unique
  titleEn     String
  titleAr     String
  titleDe     String
  excerptEn   String
  excerptAr   String
  excerptDe   String
  contentEn   String
  contentAr   String
  contentDe   String
  author      String   @default("Mr.Raw Travel Team")
  category    String   @default("Travel Guide")
  readTime    String   @default("5 min read")
  coverImage  String
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  type          String    @default("PERCENTAGE")
  value         Float
  minSpend      Float     @default(0)
  maxUses       Int       @default(100)
  usedCount     Int       @default(0)
  expiryDate    DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  @@index([code])
}

model Guide {
  id        String   @id @default(uuid())
  name      String
  phone     String
  languages String
  rating    Float    @default(5.0)
  avatar    String?
  isAvailable Boolean @default(true)
  createdAt DateTime @default(now())
}

model Driver {
  id          String   @id @default(uuid())
  name        String
  phone       String
  licenseNo   String
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Vehicle {
  id         String   @id @default(uuid())
  model      String
  plateNo    String
  capacity   Int      @default(14)
  isAvailable Boolean @default(true)
  createdAt  DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String?  // Stored as plain text for permanent immutable auditing
  userRole  String?
  action    String
  resource  String?  // e.g. TRIPS, PACKAGES, BOOKINGS, USERS
  details   String?
  ipAddress String?
  browser   String?
  os        String?
  device    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  entity    String
  entityId  String
  action    String
  changes   String?
  createdAt DateTime @default(now())
}

model RolePermission {
  id          String   @id @default(uuid())
  role        String   // SUPER_ADMIN, ADMIN, CONTENT_EDITOR, CUSTOMER_SUPPORT
  resource    String   // TRIPS, PACKAGES, BOOKINGS, CUSTOMERS, GALLERY, REVIEWS, BLOG, COUPONS, PAYMENTS, ANALYTICS, SETTINGS, USERS
  canView     Boolean  @default(true)
  canCreate   Boolean  @default(false)
  canEdit     Boolean  @default(false)
  canDelete   Boolean  @default(false)
  canApprove  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([role, resource])
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userEmail String
  ipAddress String?
  country   String?
  city      String?
  browser   String?
  os        String?
  device    String?
  status    String   @default("SUCCESS") // SUCCESS, FAILED
  createdAt DateTime @default(now())

  @@index([userEmail])
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  ipAddress    String?
  browser      String?
  os           String?
  device       String?
  isRevoked    Boolean  @default(false)
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model AdminNotification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   @default("INFO") // USER_CREATED, USER_DELETED, ROLE_CHANGED, TRIP_DELETED, PRICE_CHANGED
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Settings {
  id            String   @id @default(uuid())
  key           String   @unique
  value         String
  updatedAt     DateTime @updatedAt
}

model SiteContent {
  id        String   @id @default(uuid())
  key       String   @unique // e.g. "home.hero.title" or "footer.description"
  section   String   @default("GENERAL") // HOME, FOOTER, FAQ, TESTIMONIALS, CONTACT, ABOUT, TRIPS, CATEGORIES, SPECIAL_OFFERS, BLOG, 404, BOOKING, CONFIRMATION
  textEn    String
  textAr    String
  textDe    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([section])
  @@index([key])
}

