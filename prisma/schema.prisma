// Prisma Schema for Mr.Raw Travel - Enterprise Tourism Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  password      String?
  role          String    @default("CUSTOMER") // SUPER_ADMIN, ADMIN, MANAGER, ACCOUNTANT, GUIDE, DRIVER, CUSTOMER
  phone         String?
  whatsApp      String?
  nationality   String?
  country       String?
  city          String?
  avatar        String?
  language      String    @default("en")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  bookings      Booking[]
  reviews       Review[]
  activityLogs  ActivityLog[]
  auditLogs     AuditLog[]
  customerProfile CustomerProfile?

  @@index([email])
  @@index([role])
}

model CustomerProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalSpendUsd    Float    @default(0)
  totalSpendEur    Float    @default(0)
  totalSpendEgp    Float    @default(0)
  totalSpendGbp    Float    @default(0)
  bookingCount     Int      @default(0)
  segment          String   @default("STANDARD") // VIP, GOLD, REPEAT, STANDARD, FAMILY
  favoriteCategory String?
  marketingSource  String?  @default("DIRECT")
  tags             String?  // JSON string e.g. ["German", "Yacht", "High Value"]
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([segment])
}

model TripCategory {
  id          String   @id @default(uuid())
  slug        String   @unique
  nameEn      String
  nameAr      String
  nameDe      String
  descEn      String?
  descAr      String?
  descDe      String?
  icon        String?
  image       String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trips       Trip[]

  @@index([slug])
}

model Trip {
  id              String         @id @default(uuid())
  slug            String         @unique
  titleEn         String
  titleAr         String
  titleDe         String
  descEn          String
  descAr          String
  descDe          String
  categoryId      String
  category        TripCategory   @relation(fields: [categoryId], references: [id])
  
  // Base Prices Across 4 Currencies
  priceAdultUsd   Float
  priceChildUsd   Float
  priceAdultEur   Float
  priceChildEur   Float
  priceAdultEgp   Float
  priceChildEgp   Float
  priceAdultGbp   Float          @default(38.0)
  priceChildGbp   Float          @default(20.0)

  duration        String         // e.g. "8 Hours"
  pickupTime      String         // e.g. "08:00 AM"
  location        String         @default("Hurghada, Egypt")
  meetingPoint    String?
  maxSeats        Int            @default(30)
  bookedSeats     Int            @default(0)
  isFeatured      Boolean        @default(false)
  isSpecialOffer  Boolean        @default(false)
  discountPercent Int            @default(0)
  rating          Float          @default(4.9)
  reviewCount     Int            @default(0)

  includedEn      String
  includedAr      String
  includedDe      String
  excludedEn      String
  excludedAr      String
  excludedDe      String
  itineraryEn     String
  itineraryAr     String
  itineraryDe     String

  coverImage      String
  isPublished     Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  images          TripImage[]
  bookings        Booking[]
  reviews         Review[]
  schedules       TripSchedule[]
  pricingRules    TripPricingRule[]

  @@index([slug])
  @@index([categoryId])
  @@index([isPublished])
  @@index([isFeatured])
}

model TripPricingRule {
  id              String   @id @default(uuid())
  tripId          String
  trip            Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  ruleName        String   // e.g. "SUMMER_DISCOUNT", "PEAK_HOLIDAY", "EARLY_BIRD"
  seasonType      String   @default("STANDARD") // SUMMER, WINTER, HOLIDAY, WEEKEND, VIP
  multiplier      Float    @default(1.0) // e.g. 1.25 for +25% peak
  startDate       DateTime?
  endDate         DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model TripImage {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model TripSchedule {
  id             String   @id @default(uuid())
  tripId         String
  trip           Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  date           DateTime
  pickupTime     String?
  maxSeats       Int      @default(30)
  availableSeats Int      @default(30)
  reservedSeats  Int      @default(0)
  bookedSeats    Int      @default(0)
  waitingListCount Int    @default(0)
  status         String   @default("OPEN") // OPEN, FULL, CANCELLED, COMPLETED
  guideId        String?
  driverId       String?
  vehicleId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bookings       Booking[]

  @@index([tripId, date])
  @@index([status])
}

model Booking {
  id              String        @id @default(uuid())
  bookingNumber   String        @unique
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
  tripId          String
  trip            Trip          @relation(fields: [tripId], references: [id])
  scheduleId      String?
  schedule        TripSchedule? @relation(fields: [scheduleId], references: [id])
  
  tripDate        DateTime
  pickupLocation  String
  hotelName       String
  hotelAddress    String?
  roomNumber      String?
  pickupTime      String?

  leadPassengerName String
  leadEmail         String
  leadPhone         String
  leadWhatsApp      String
  leadNationality   String
  emergencyContact  String?
  specialNotes      String?

  adults          Int           @default(1)
  children        Int           @default(0)
  currency        String        @default("USD") // USD, EUR, EGP, GBP
  totalPrice      Float
  
  paymentMethod   String        // CASH, INSTAPAY, VODAFONE_CASH, BANK_TRANSFER, CARD
  paymentStatus   String        @default("PENDING") // PENDING, WAITING_REVIEW, APPROVED, REJECTED, REFUNDED
  bookingStatus   String        @default("PENDING") // PENDING, CONFIRMED, CANCELLED, COMPLETED

  qrToken         String        @unique
  voucherPdfUrl   String?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  passengers      BookingPassenger[]
  payments        Payment[]
  receipts        PaymentReceipt[]

  @@index([bookingNumber])
  @@index([userId])
  @@index([paymentStatus])
  @@index([bookingStatus])
  @@index([tripDate])
}

model BookingPassenger {
  id        String   @id @default(uuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  name      String
  type      String   @default("ADULT") // ADULT, CHILD
  passport  String?
  createdAt DateTime @default(now())
}

model Payment {
  id            String          @id @default(uuid())
  bookingId     String
  booking       Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount        Float
  currency      String          @default("USD")
  method        String          // CASH, INSTAPAY, VODAFONE_CASH, BANK_TRANSFER, CARD
  status        String          @default("PENDING") // PENDING, SUCCESS, FAILED
  transactionId String?
  notes         String?
  createdAt     DateTime        @default(now())

  receipts      PaymentReceipt[]
}

model PaymentReceipt {
  id         String   @id @default(uuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paymentId  String?
  payment    Payment? @relation(fields: [paymentId], references: [id])
  imageUrl   String
  fileType   String   @default("IMAGE")
  status     String   @default("PENDING") // PENDING, APPROVED, REJECTED
  adminNotes String?
  uploadedAt DateTime @default(now())

  @@index([status])
}

model Review {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  author    String
  country   String   @default("Germany")
  rating    Int      @default(5)
  title     String?
  comment   String
  avatar    String?
  isVerified Boolean @default(true)
  createdAt DateTime @default(now())

  @@index([tripId])
}

model GalleryItem {
  id        String   @id @default(uuid())
  titleEn   String
  titleAr   String
  titleDe   String
  category  String   @default("SEA")
  url       String
  location  String   @default("Hurghada")
  mediaType String   @default("IMAGE") // IMAGE, VIDEO, 360, DRONE
  createdAt DateTime @default(now())
}

model BlogPost {
  id          String   @id @default(uuid())
  slug        String   @unique
  titleEn     String
  titleAr     String
  titleDe     String
  excerptEn   String
  excerptAr   String
  excerptDe   String
  contentEn   String
  contentAr   String
  contentDe   String
  author      String   @default("Mr.Raw Travel Team")
  category    String   @default("Travel Guide")
  readTime    String   @default("5 min read")
  coverImage  String
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  type          String    @default("PERCENTAGE")
  value         Float
  minSpend      Float     @default(0)
  maxUses       Int       @default(100)
  usedCount     Int       @default(0)
  expiryDate    DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  @@index([code])
}

model Guide {
  id        String   @id @default(uuid())
  name      String
  phone     String
  languages String
  rating    Float    @default(5.0)
  avatar    String?
  isAvailable Boolean @default(true)
  createdAt DateTime @default(now())
}

model Driver {
  id          String   @id @default(uuid())
  name        String
  phone       String
  licenseNo   String
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Vehicle {
  id         String   @id @default(uuid())
  model      String
  plateNo    String
  capacity   Int      @default(14)
  isAvailable Boolean @default(true)
  createdAt  DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  entity    String
  entityId  String
  action    String
  changes   String?
  createdAt DateTime @default(now())
}

model Settings {
  id            String   @id @default(uuid())
  key           String   @unique
  value         String
  updatedAt     DateTime @updatedAt
}
